--- !u!1001 &1173270047
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 548786088}
    m_Modifications:
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 424726846}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: dialogues.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CWhat are you trying to do? Get off.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201COh yes, you could say they really love the smell of their lawn.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CThe view up there it\u2019s lovely, so who wouldn\u2019t spend
        most of their time admiring their guests from above?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[3]'
      value: "\u201CDefinitely, it\u2019s almost impossible to interrupt them while
        they\u2019re dancing.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[4]'
      value: "\u201CProbably they love the food it offers more than the room they\u2019re
        stationed in.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1120936571411305711, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}

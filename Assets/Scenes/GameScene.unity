--- !u!1001 &1481093568
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 548786088}
    m_Modifications:
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 424726846}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: dialogues.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CWhy should I be concerned with what you think? Leave me alone.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201CDefinitely not, their voice is as low as always.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CIt seems perfectly normal to me, neither too low or too high.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[3]'
      value: "\u201CIt\u2019s a shrill voice that perfectly fits our host.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[4]'
      value: "\u201CTheir words sounded as melodic as it was almost singing.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1120936571411305711, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: m_LocalScale.x
      value: 0.3
      objectReference: {fileID: 0}

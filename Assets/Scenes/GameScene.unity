--- !u!1001 &1661585332
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 548786088}
    m_Modifications:
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 424726846}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: question
      value: "\u201COur host shows a fine taste as always, such a unique choice for
        covering their neck. Would you think it\u2019s enough to protect them from
        the wind?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: dialogues.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CMy bad, did I give you the impression I wanted to talk with you?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201CMaybe it\u2019s not designed to keep a person warm, but it sure
        looks good on them.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CI\u2019m quite sure they didn\u2019t adorn their neck with anything
        like that.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 1120936571411305711, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}

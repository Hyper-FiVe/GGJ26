--- !u!1001 &290965169
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 548786088}
    m_Modifications:
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 424726846}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: question
      value: "\u201CDecorating oneself with an elegant headdress shows great knowledge
        in noble apparel. How would you describe our host\u2019s choice in regard?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: dialogues.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CThat\u2019s not something I\u2019m willing to discuss with you.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201CYes, quite an interesting choice but it looks majestic on them.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CWhat are you talking about? They aren\u2019t wearing anything
        on their head.\u201D"
      objectReference: {fileID: 0}

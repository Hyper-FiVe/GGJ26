    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CMy bad, did I give you the impression I wanted to talk with you?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201CMaybe it\u2019s not designed to keep a person warm, but it sure
        looks good on them.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CI\u2019m quite sure they didn\u2019t adorn their neck with anything
        like that.\u201D"

PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 548786088}
    m_Modifications:
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 424726846}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: question
      value: "\u201CWhat an exquisite garment our host is brandishing on this lovely
        night. What do its colours remind you of?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: dialogues.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u201CDon\u2019t you have eyes? Check for yourself.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u201COh, for sure it\u2019s that of a soothing fire\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u201CTo me it\u2019s like a flourishing field of grass\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[3]'
      value: "\u201CMmh\u2026 a calm sea?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 448408648917939218, guid: 9c6732c903c43fb4a831489400f407ed, type: 3}
      propertyPath: 'dialogues.Array.data[4]'
      value: "\u201CA lovely lilac bouquet\u201D"
      objectReference: {fileID: 0}
